{
  "//": "サイトが2つある。本体は poster-kanri、旧URL（poster-kanri-94627）は転送のみ",
  "hosting": [
    {
      "site": "poster-kanri",
      "public": "public",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "test/**"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }],
      "headers": [
        {
          "//": "ファイル名にハッシュを付けていないためURLが変わらない。キャッシュを許すと更新が届かなくなる",
          "source": "/",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "//": "ルート「/」は **/*.html に一致しないため、上で個別に指定している",
          "source": "**/*.@(html|css|js|mjs|json)",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        }
      ]
    },
    {
      "//": [
        "旧URL。新URLへ転送するだけ。",
        "放置すると、ブックマークから開いた人が古い版を使い続け、",
        "そちらの端末内保存（IndexedDB はオリジン単位）にデータが溜まってしまう。",
        "入口を1つに絞るために転送を置く。",
        "認証ハンドラ（/__/auth/**）は Hosting の予約パスで、転送より先に処理される。"
      ],
      "site": "poster-kanri-94627",
      "public": "legacy-site",
      "ignore": ["firebase.json", "**/.*"],
      "redirects": [
        {
          "source": "/**",
          "destination": "https://poster-kanri.firebaseapp.com/",
          "type": 301
        }
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
